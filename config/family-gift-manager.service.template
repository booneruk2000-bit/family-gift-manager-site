[Unit]
Description=Family Gift Manager Website Daemon
Documentation=https://github.com/booneruk2000-bit/family-gift-manager-site
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
Environment=XDG_DATA_HOME=/var/lib/family-gift-manager
Environment=XDG_CONFIG_HOME=/var/lib/family-gift-manager/config
ExecStart=/usr/bin/caddy run --environ --config __CADDYFILE_PATH__ --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config __CADDYFILE_PATH__ --adapter caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
Restart=on-failure
RestartSec=3s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
